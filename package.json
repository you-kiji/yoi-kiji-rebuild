{
  "name": "yoi-kiji",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && if [ \"$VERCEL_ENV\" = \"production\" ] || [ \"$VERCEL_ENV\" = \"preview\" ]; then prisma migrate deploy; fi && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:demo": "node prisma/demo-content-seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "@types/pdfkit": "^0.17.3",
    "vite": "^8.0.11"
  },
  "overrides": {
    "csstype": "3.2.3",
    "postcss": "8.5.23",
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.1"
  },
  "packageManager": "npm@10.9.4"
}
